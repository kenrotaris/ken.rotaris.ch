# Directus content source. Leave DIRECTUS_URL/DIRECTUS_TOKEN empty to render
# from the YAML in public/data instead.
DIRECTUS_URL=https://edit.webmo.ch
# Static token for the "Portfolio renderer read-only" role.
DIRECTUS_TOKEN=

# Origin allowed to frame the site for the Directus visual editor.
# Defaults to the DIRECTUS_URL origin; set it only if they differ.
VISUAL_EDITOR_ORIGIN=

# Shared secret for POST /api/revalidate, called by a Directus flow on publish.
REVALIDATE_SECRET=

# Admin token, used only by scripts/directus-setup.mjs. Never needed at runtime.
DIRECTUS_ADMIN_TOKEN=
